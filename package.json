{
  "name": "fizra-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply fizra --local",
    "db:migrate:remote": "wrangler d1 migrations apply fizra --remote",
    "deploy": "npm run build:web && wrangler deploy",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "keys": "node scripts/gen-keys.mjs"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
